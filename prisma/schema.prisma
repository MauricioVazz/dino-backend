generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(uuid()) @map("public_id")
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // "user" ou "admin"
  avatarUrl String?  // opcional
  createdAt DateTime @default(now()) @map("created_at")

  favorites FavoriteDino[]

  @@map("users")
}


model FavoriteDino {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(uuid()) @map("public_id")

  dinoName  String   @map("dino_name")

  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  // Regra de domínio garantida no banco
  @@unique([userId, dinoName])

  @@map("favorite_dinos")
}
